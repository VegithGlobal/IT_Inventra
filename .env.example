# ─────────────────────────────────────────────────────────────────────────────
# IT Ops Hub — environment variables. Copy to `.env` and fill in.
# Never commit `.env` (it's git-ignored).
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string used by Prisma (app + migrations + seed).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/it_ops_hub?schema=public"

# Public base URL of the app. Used by NextAuth for callbacks and in QR codes on asset labels
# (labels link to <NEXTAUTH_URL>/assets/<id>, so set this to the real URL in production).
NEXTAUTH_URL="http://localhost:3000"

# Secret that signs/encrypts session tokens. Any long random string.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# 32-byte key (64 hex chars) for AES-256-GCM encryption of stored secrets
# (subscription credentials, license keys). Changing it makes existing secrets unreadable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Shared secret for the reminders cron endpoint (/api/cron/reminders).
# The scheduler must send it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""

# Self-hosting only: "internal" makes the server call the reminders endpoint itself every hour
# (src/instrumentation.ts). Leave empty on Vercel (vercel.json schedules it) or when using system cron.
CRON_MODE=""

# File storage. "local" stores uploads on disk under UPLOAD_DIR (served only to signed-in users).
# The storage layer (src/lib/storage) is where an S3 / Cloudflare R2 driver plugs in later.
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
# Max upload size in MB (PDF, JPG, PNG, WEBP). Keep at or below 10 unless you also raise the
# body-size limits in next.config.ts.
MAX_UPLOAD_MB="10"

# Outgoing email (Nodemailer) for reminder notifications. Leave SMTP_HOST empty to
# disable email. SMTP_SECURE="true" for port 465 (implicit TLS), "false" for 587 (STARTTLS).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="IT Ops Hub <it@company.com>"

# First-run setup for a real install (`npm run db:init`, no demo data). Only needed when you run it;
# you can also pass them on the command line instead of keeping them here.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
COMPANY_NAME=""

# Demo data only (`npm run db:seed` — wipes the database!). Refused when NODE_ENV=production
# unless ALLOW_DEMO_SEED="1".
# Password given to the seeded users (admin@, staff@, viewer@company.com):
SEED_ADMIN_PASSWORD="Admin@123"
